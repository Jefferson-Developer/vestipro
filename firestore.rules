rules_version = '2';

// Firestore Security Rules — VestiPro (TASK-030).
//
// Escopo: `organizations/{organizationId}` e as subcoleções já modeladas até
// aqui (`companies`, `branches`, `roles`, `teams`, `members`, `invites`,
// `auditLogs`), conforme TASK-026 a TASK-029, TASK-033, TASK-039 e
// `tasks.md` seção 13 ("Nunca
// permitir que `organizationId` enviado pelo cliente seja a única fonte de
// autorização").
//
// Princípio central: toda leitura/escrita dentro de uma Organization exige
// um Membership REAL e ativo do usuário autenticado em
// `organizations/{organizationId}/members/{request.auth.uid}` — nunca um
// campo `organizationId` presente no próprio payload/documento sendo lido
// ou escrito. `isActiveMember` é a única função que decide "pertence a esta
// organização" e sempre relê esse documento a partir do banco.
//
// RBAC: `roleHasCapability` espelha, em Rules, exatamente a mesma tabela de
// `lib/core/permissions/role_permission_matrix.dart` (TASK-029) — os dois
// precisam ser mantidos em sincronia manualmente (ver
// TASK-030-criar-firestore-security-rules-CONCLUIDA.md, seção "Riscos
// conhecidos"). Os códigos de capability usados aqui são exatamente os de
// `lib/core/permissions/capability.dart` (`CapabilityCode.code`).
//
// Bootstrap de tenant (histórico): até a TASK-037, `CreateOrganizationUseCase`
// -> `EnsureSystemRolesUseCase` -> `AssignRoleToUserUseCase` (papel OWNER)
// rodavam diretamente do cliente, em sequência, sem Cloud Function dedicada —
// e existiam aqui 3 janelas de bootstrap deliberadas e estreitas para isso
// (criação da própria Organization, dos 7 system roles fixos, e da própria
// Membership OWNER). A TASK-037 substituiu esse fluxo pela Cloud Function
// callable `createOrganization` (`functions/src/organizations/create-organization.ts`),
// que cria a Organization, semeia os 7 system roles e concede a Membership
// OWNER numa única transação server-side com o Admin SDK — que ignora estas
// regras por definição. As 3 janelas de bootstrap foram removidas: nenhuma
// dessas três escritas é mais permitida a partir do cliente, nem mesmo para
// quem seria o criador legítimo.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function membershipPath(organizationId) {
      return /databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid);
    }

    // Único ponto que decide "este usuário autenticado pertence a esta
    // Organization agora" — sempre relendo o Membership real, nunca
    // confiando em nenhum campo do documento sendo lido/escrito.
    function isActiveMember(organizationId) {
      return isSignedIn()
        && exists(membershipPath(organizationId))
        && get(membershipPath(organizationId)).data.status == 'active';
    }

    function currentRoleName(organizationId) {
      return get(membershipPath(organizationId)).data.roleName;
    }

    // Espelha lib/core/permissions/role_permission_matrix.dart (TASK-029).
    // READ_ONLY e qualquer nome de role desconhecido/custom caem no `else`
    // implícito (nenhuma cláusula bate) => default-deny, igual ao Dart.
    function roleHasCapability(roleName, capabilityCode) {
      return roleName == 'OWNER'
        || (roleName == 'ADMIN' && capabilityCode != 'organization.transferOwnership')
        || (roleName == 'SALES_MANAGER' && capabilityCode in [
              'customer.create', 'customer.update', 'customer.delete',
              'order.create', 'order.view', 'order.approve', 'discount.approveAboveLimit',
              'team.manage', 'report.export', 'report.viewSensitive',
              'report.share.team', 'report.share.organization', 'report.schedule',
              'customer.import'
            ])
        || (roleName == 'SALES_REP' && capabilityCode in [
              'customer.create', 'customer.update', 'order.create', 'order.view',
              'report.share.team'
            ])
        || (roleName == 'SALES_ASSISTANT' && capabilityCode in [
              'customer.create', 'customer.update'
            ])
        || (roleName == 'FINANCE' && capabilityCode in [
              'finance.view', 'finance.manage', 'discount.approveAboveLimit',
              'report.export', 'report.viewSensitive', 'priceList.manage',
              'report.share.team', 'report.share.organization'
            ]);
    }

    // Re-verifica sempre a Membership real (nunca confia em capability
    // resolvida no cliente) antes de checar a matriz de roles.
    function hasCapability(organizationId, capabilityCode) {
      return isActiveMember(organizationId)
        && roleHasCapability(currentRoleName(organizationId), capabilityCode);
    }

    function isOwnerOrAdmin(organizationId) {
      return isActiveMember(organizationId)
        && currentRoleName(organizationId) in ['OWNER', 'ADMIN'];
    }

    function isSalesManager(organizationId) {
      return isActiveMember(organizationId)
        && currentRoleName(organizationId) == 'SALES_MANAGER';
    }

    function isSalesRep(organizationId) {
      return isActiveMember(organizationId)
        && currentRoleName(organizationId) == 'SALES_REP';
    }

    function requesterTeamIds(organizationId) {
      return get(membershipPath(organizationId)).data.teamIds;
    }

    function memberPath(organizationId, userId) {
      return /databases/$(database)/documents/organizations/$(organizationId)/members/$(userId);
    }

    // TASK-140: seller aggregates are visible to the seller themself, to a
    // manager sharing at least one active team with that seller, and to the
    // tenant-wide reporting roles. The aggregate payload can never grant
    // access by itself; the real Membership documents are always re-read.
    function canReadSellerAggregate(organizationId) {
      return isActiveMember(organizationId)
        && (
          resource.data.scopeId == request.auth.uid
          || currentRoleName(organizationId) in ['OWNER', 'ADMIN', 'FINANCE']
          || (
            isSalesManager(organizationId)
            && exists(memberPath(organizationId, resource.data.scopeId))
            && get(memberPath(organizationId, resource.data.scopeId)).data.status == 'active'
            && requesterTeamIds(organizationId).hasAny(
              get(memberPath(organizationId, resource.data.scopeId)).data.teamIds
            )
          )
        );
    }

    function teamPath(organizationId, teamId) {
      return /databases/$(database)/documents/organizations/$(organizationId)/teams/$(teamId);
    }

    // TASK-045 contract consumed by TASK-051:
    // Customer docs must denormalize `primarySalesRepId` and primary `teamId`
    // so queries and Rules can enforce portfolio visibility without reading
    // a Customer model on the client in this task.
    function validCustomerVisibilityPayload(organizationId) {
      return resource.data.keys().hasAll([
          'organizationId',
          'companyId',
          'primarySalesRepId',
          'teamId',
          'deletedAt'
        ])
        && resource.data.organizationId == organizationId
        && resource.data.companyId is string
        && resource.data.companyId.size() > 0
        && resource.data.primarySalesRepId is string
        && resource.data.primarySalesRepId.size() > 0
        && resource.data.teamId is string
        && resource.data.teamId.size() > 0
        && resource.data.deletedAt == null;
    }

    function customerIsActive() {
      return resource.data.deletedAt == null;
    }

    function managerCanReadCustomer(organizationId) {
      return isSalesManager(organizationId)
        && (
          requesterTeamIds(organizationId).hasAny([resource.data.teamId])
          || (
            exists(teamPath(organizationId, resource.data.teamId))
            && get(teamPath(organizationId, resource.data.teamId)).data.managerUserId == request.auth.uid
          )
        );
    }

    function canReadCustomer(organizationId) {
      return validCustomerVisibilityPayload(organizationId)
        && (
          isOwnerOrAdmin(organizationId)
          || managerCanReadCustomer(organizationId)
          || (
            isSalesRep(organizationId)
            && resource.data.primarySalesRepId == request.auth.uid
          )
        );
    }

    function canListCustomers(organizationId) {
      return isOwnerOrAdmin(organizationId)
        || (
          customerIsActive()
          && (
            managerCanReadCustomer(organizationId)
            || (
              isSalesRep(organizationId)
              && resource.data.primarySalesRepId == request.auth.uid
            )
          )
        );
    }

    // -----------------------------------------------------------------------
    // organizations/{organizationId}/orders/{orderId} (TASK-102)
    // -----------------------------------------------------------------------

    // Mirrors `validCustomerVisibilityPayload`: every field a client query or
    // this rule itself needs to decide visibility must already be on the
    // Order document written by `submitOrder` (TASK-101) — never inferred.
    function validOrderVisibilityPayload(organizationId) {
      return resource.data.keys().hasAll([
          'organizationId',
          'companyId',
          'sellerId',
          'deletedAt'
        ])
        && resource.data.organizationId == organizationId
        && resource.data.companyId is string
        && resource.data.companyId.size() > 0
        && resource.data.sellerId is string
        && resource.data.sellerId.size() > 0
        && resource.data.deletedAt == null;
    }

    // A SALES_MANAGER may read an Order when its own seller belongs to one of
    // the manager's teams — re-derived from that seller's real Membership
    // (never from a client-supplied list), the same one extra `get()` per
    // document `managerCanReadCustomer` already costs for its own team
    // lookup. There is no denormalized `teamId` on Order (unlike Customer):
    // one seller can belong to more than one team, so this compares the full
    // `teamIds` array instead of a single field.
    function managerCanReadOrder(organizationId) {
      return isSalesManager(organizationId)
        && exists(/databases/$(database)/documents/organizations/$(organizationId)/members/$(resource.data.sellerId))
        && requesterTeamIds(organizationId).hasAny(
            get(/databases/$(database)/documents/organizations/$(organizationId)/members/$(resource.data.sellerId)).data.teamIds
          );
    }

    function canReadOrder(organizationId) {
      return validOrderVisibilityPayload(organizationId)
        && (
          isOwnerOrAdmin(organizationId)
          || (isSalesRep(organizationId) && resource.data.sellerId == request.auth.uid)
          || managerCanReadOrder(organizationId)
        );
    }

    function validProductReadPayload(organizationId) {
      return resource.data.keys().hasAll([
          'organizationId',
          'deletedAt'
        ])
        && resource.data.organizationId == organizationId
        && resource.data.deletedAt == null;
    }

    function canReadProduct(organizationId) {
      return isActiveMember(organizationId)
        && validProductReadPayload(organizationId);
    }

    function validProductVariantPayload(organizationId, data) {
      return data.keys().hasOnly([
          'organizationId',
          'productId',
          'colorId',
          'sizeGridTemplateId',
          'sizeId',
          'sku',
          'ean',
          'manualAvailabilityStatus',
          'manualAvailableQuantity',
          'manualFutureAvailableAt',
          'status',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy',
          'version',
          'syncStatus'
        ])
        && data.keys().hasAll([
          'organizationId',
          'productId',
          'colorId',
          'sizeGridTemplateId',
          'sizeId',
          'sku',
          'status',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy',
          'version',
          'syncStatus'
        ])
        && data.organizationId == organizationId
        && data.productId is string
        && data.productId.size() > 0
        && data.colorId is string
        && data.colorId.size() > 0
        && data.sizeGridTemplateId is string
        && data.sizeGridTemplateId.size() > 0
        && data.sizeId is string
        && data.sizeId.size() > 0
        && data.sku is string
        && data.sku.matches('^[A-Z0-9]+([_-][A-Z0-9]+)*$')
        && (
          !data.keys().hasAny(['ean'])
          || data.ean == null
          || (
            data.ean is string
            && (
              data.ean.matches('^[0-9]{8}$')
              || data.ean.matches('^[0-9]{13}$')
            )
          )
        )
        && (
          !data.keys().hasAny(['manualAvailabilityStatus'])
          || data.manualAvailabilityStatus in [
            'readyStock',
            'futureStock',
            'unavailable'
          ]
        )
        && (
          !data.keys().hasAny(['manualAvailableQuantity'])
          || (
            data.manualAvailableQuantity is int
            && data.manualAvailableQuantity >= 0
          )
        )
        && (
          !data.keys().hasAny(['manualFutureAvailableAt'])
          || data.manualFutureAvailableAt is timestamp
        )
        && data.status in ['active', 'inactive']
        && data.createdAt is timestamp
        && data.createdBy is string
        && data.createdBy.size() > 0
        && data.updatedAt is timestamp
        && data.updatedBy is string
        && data.updatedBy.size() > 0
        && data.version is int
        && data.version >= 1
        && data.syncStatus in ['pending', 'syncing', 'synced', 'failed', 'conflict'];
    }

    function canReadProductVariant(organizationId) {
      return isActiveMember(organizationId)
        && resource.data.organizationId == organizationId;
    }

    function canCreateProductVariant(organizationId) {
      return hasCapability(organizationId, 'catalog.manage')
        && validProductVariantPayload(organizationId, request.resource.data);
    }

    function canUpdateProductVariant(organizationId) {
      return hasCapability(organizationId, 'catalog.manage')
        && validProductVariantPayload(organizationId, request.resource.data)
        && unchanged('organizationId')
        && unchanged('productId')
        && unchanged('colorId')
        && unchanged('sizeGridTemplateId')
        && unchanged('sizeId')
        && unchanged('createdAt')
        && unchanged('createdBy');
    }

    // -----------------------------------------------------------------
    // organizations/{organizationId}/priceLists/{priceListId}  (TASK-083)
    // -----------------------------------------------------------------

    function validPriceListPayload(organizationId, data) {
      return data.keys().hasOnly([
          'organizationId',
          'companyId',
          'name',
          'currency',
          'validFrom',
          'validTo',
          'status',
          'scope',
          'scopeValue',
          'priority',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy',
          'deletedAt',
          'version',
          'syncStatus'
        ])
        && data.keys().hasAll([
          'organizationId',
          'companyId',
          'name',
          'currency',
          'validFrom',
          'status',
          'scope',
          'priority',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy',
          'version',
          'syncStatus'
        ])
        && data.organizationId == organizationId
        && data.companyId is string
        && data.companyId.size() > 0
        && data.name is string
        && data.name.size() > 0
        && data.currency is string
        && data.currency.matches('^[A-Z]{3}$')
        && data.validFrom is timestamp
        && (
          !data.keys().hasAny(['validTo'])
          || data.validTo == null
          || (data.validTo is timestamp && data.validTo > data.validFrom)
        )
        && data.status in ['draft', 'active', 'expired', 'archived']
        && data.scope in ['company', 'channel', 'segment']
        && (
          (data.scope == 'company'
            && (!data.keys().hasAny(['scopeValue']) || data.scopeValue == null))
          || (data.scope != 'company'
            && data.keys().hasAny(['scopeValue'])
            && data.scopeValue is string
            && data.scopeValue.size() > 0)
        )
        && data.priority is int
        && data.createdAt is timestamp
        && data.createdBy is string
        && data.createdBy.size() > 0
        && data.updatedAt is timestamp
        && data.updatedBy is string
        && data.updatedBy.size() > 0
        && data.version is int
        && data.version >= 1
        && data.syncStatus in ['pending', 'syncing', 'synced', 'failed', 'conflict'];
    }

    function canReadPriceList(organizationId) {
      return isActiveMember(organizationId)
        && resource.data.organizationId == organizationId;
    }

    function validWarehousePayload(organizationId, data) {
      return data.keys().hasOnly([
          'organizationId',
          'companyId',
          'branchId',
          'code',
          'name',
          'type',
          'isActive',
          'priority',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy',
          'deletedAt',
          'version',
          'syncStatus'
        ])
        && data.keys().hasAll([
          'organizationId',
          'companyId',
          'code',
          'name',
          'type',
          'isActive',
          'priority',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy',
          'version',
          'syncStatus'
        ])
        && data.organizationId == organizationId
        && data.companyId is string
        && data.companyId.size() > 0
        && (
          !data.keys().hasAny(['branchId'])
          || data.branchId == null
          || (data.branchId is string && data.branchId.size() > 0)
        )
        && data.code is string
        && data.code.size() > 0
        && data.name is string
        && data.name.size() > 0
        && data.type in [
          'headquarters',
          'distributionCenter',
          'store',
          'consigned'
        ]
        && data.isActive is bool
        && data.priority is int
        && data.priority >= 0
        && data.createdAt is timestamp
        && data.createdBy is string
        && data.createdBy.size() > 0
        && data.updatedAt is timestamp
        && data.updatedBy is string
        && data.updatedBy.size() > 0
        && (
          !data.keys().hasAny(['deletedAt'])
          || data.deletedAt == null
          || data.deletedAt is timestamp
        )
        && data.version is int
        && data.version >= 1
        && data.syncStatus in ['pending', 'syncing', 'synced', 'failed', 'conflict'];
    }

    function canReadWarehouse(organizationId) {
      return isActiveMember(organizationId)
        && resource.data.organizationId == organizationId;
    }

    function canWriteWarehouse(organizationId) {
      return hasCapability(organizationId, 'inventory.adjust')
        && validWarehousePayload(organizationId, request.resource.data);
    }

    function canReadInventoryBalance(organizationId) {
      return isActiveMember(organizationId)
        && resource.data.organizationId == organizationId;
    }

    function canReadStockReservation(organizationId) {
      return isActiveMember(organizationId)
        && resource.data.organizationId == organizationId;
    }

    function canCreatePriceList(organizationId) {
      return hasCapability(organizationId, 'priceList.manage')
        && validPriceListPayload(organizationId, request.resource.data);
    }

    // Currency is immutable once a Price List exists (TASK-083 business
    // rule): changing it always means creating a new Price List, never
    // editing this one.
    function canUpdatePriceList(organizationId) {
      return hasCapability(organizationId, 'priceList.manage')
        && validPriceListPayload(organizationId, request.resource.data)
        && unchanged('organizationId')
        && unchanged('companyId')
        && unchanged('currency')
        && unchanged('createdAt')
        && unchanged('createdBy');
    }

    function portfolioAssignmentPayloadValid(organizationId, data) {
      return data.organizationId == organizationId
        && data.companyId is string
        && data.companyId.size() > 0
        && data.userId is string
        && data.userId.size() > 0
        && data.teamId is string
        && data.teamId.size() > 0
        && data.scopeType in ['customer', 'criteria']
        && data.status in ['active', 'reassigned', 'archived']
        && data.version is int
        && data.createdBy is string
        && data.createdBy.size() > 0
        && data.updatedBy is string
        && data.updatedBy.size() > 0
        && (
          (
            data.scopeType == 'customer'
            && data.customerId is string
            && data.customerId.size() > 0
          )
          || (
            data.scopeType == 'criteria'
            && (
              (data.region is string && data.region.size() > 0)
              || (data.segment is string && data.segment.size() > 0)
            )
          )
        );
    }

    function unchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    // ---------------------------------------------------------------------
    // users/{userId}  (basic profile — TASK-035)
    // ---------------------------------------------------------------------
    //
    // Created during sign-up, before any Organization/Membership exists for
    // that user (`CreateAccountWithEmailAndPasswordUseCase`) — so, unlike
    // every collection below, access here is scoped to "is this literally
    // my own uid", never to a Membership. Holds only the LGPD-relevant
    // basics (name, e-mail, terms consent + version/timestamp); there is no
    // `update`/`delete` path yet — profile editing is a future task's
    // responsibility, not this one's.

    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;

      // Never list every user by an open query — same rationale as
      // `organizations`'s own `allow list: if false`.
      allow list: if false;

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.termsVersion is string
        && request.resource.data.termsVersion.size() > 0;

      allow update: if false;
      allow delete: if false;

      // Immutable, user-scoped compliance trail (TASK-156). Each document
      // id includes type + version, so publishing a new version creates a
      // distinct record and no historical acceptance can be overwritten.
      match /policyAcceptances/{acceptanceId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly([
            'userId', 'type', 'version', 'acceptedAt', 'device'
          ])
          && request.resource.data.userId == userId
          && request.resource.data.type in ['privacy_policy', 'terms_of_use']
          && request.resource.data.version is string
          && request.resource.data.version.size() > 0
          && acceptanceId == request.resource.data.type + '_' + request.resource.data.version
          && request.resource.data.acceptedAt == request.time
          && (request.resource.data.device == null || request.resource.data.device is string);
        allow update, delete: if false;
      }

      // Immutable, tenant-scoped consent decisions (TASK-157). Grant and
      // revocation are separate events, preserving the full audit trail.
      match /consentRecords/{recordId} {
        allow get, list: if isSignedIn()
          && request.auth.uid == userId
          && isActiveMember(resource.data.organizationId);
        allow create: if isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly([
            'organizationId', 'userId', 'purpose', 'granted', 'recordedAt'
          ])
          && request.resource.data.userId == userId
          && request.resource.data.organizationId is string
          && isActiveMember(request.resource.data.organizationId)
          && request.resource.data.purpose in ['location', 'marketing']
          && request.resource.data.granted is bool
          && request.resource.data.recordedAt == request.time;
        allow update, delete: if false;
      }

      // Server-created personal-data portability requests (TASK-158).
      // The owner can observe status, but every mutation remains backend-only.
      match /personalDataExports/{exportId} {
        allow get, list: if isSignedIn()
          && request.auth.uid == userId
          && resource.data.userId == userId;
        allow create, update, delete: if false;
      }
    }

    // Published legal documents are readable before authentication so the
    // sign-up checkbox can always open their full content. Publishing is a
    // controlled backend/admin operation; clients can never mutate history.
    match /policyDocuments/{documentId} {
      allow get, list: if resource.data.published == true;
      allow create, update, delete: if false;
    }

    // ---------------------------------------------------------------------
    // organizationOwners/{userId}  (TASK-037)
    // ---------------------------------------------------------------------
    //
    // Idempotency marker written exclusively by the `createOrganization`
    // Cloud Function (Admin SDK) — tracks which Organization, if any, a
    // given uid created through that flow, so a retried call never creates
    // a second one for the same owner. No client operation ever needs to
    // read or write this collection directly; explicit deny-all instead of
    // relying on the implicit "no matching rule" default, so the intent is
    // unambiguous to anyone reading this file.

    match /organizationOwners/{userId} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------------
    // organizations/{organizationId}
    // ---------------------------------------------------------------------

    match /organizations/{organizationId} {
      allow get: if isActiveMember(organizationId);

      // Nunca listar tenants por uma query aberta: todo acesso deve
      // conhecer o organizationId de antemão (via path).
      allow list: if false;

      // Nunca criada pelo cliente: exclusivamente pela Cloud Function
      // `createOrganization` (Admin SDK, TASK-037), que também semeia os 7
      // system roles e a Membership OWNER na mesma transação.
      allow create: if false;

      allow update: if hasCapability(organizationId, 'organization.settingsManage')
        && unchanged('name')
        && unchanged('slug')
        && unchanged('status')
        && unchanged('createdAt')
        && unchanged('createdBy');

      allow delete: if false;

      // -------------------------------------------------------------------
      // organizations/{organizationId}/companies/{companyId}
      // -------------------------------------------------------------------

      match /companies/{companyId} {
        allow read: if isActiveMember(organizationId);

        allow create: if hasCapability(organizationId, 'company.manage')
          && request.resource.data.organizationId == organizationId;

        allow update: if hasCapability(organizationId, 'company.manage')
          && unchanged('organizationId');

        allow delete: if hasCapability(organizationId, 'company.manage');
      }

      // -------------------------------------------------------------------
      // organizations/{organizationId}/branches/{branchId}
      // -------------------------------------------------------------------

      match /branches/{branchId} {
        allow read: if isActiveMember(organizationId);

        allow create: if hasCapability(organizationId, 'branch.manage')
          && request.resource.data.organizationId == organizationId;

        allow update: if hasCapability(organizationId, 'branch.manage')
          && unchanged('organizationId')
          && unchanged('companyId');

        allow delete: if hasCapability(organizationId, 'branch.manage');
      }

      // -------------------------------------------------------------------
      // organizations/{organizationId}/roles/{roleId}
      // -------------------------------------------------------------------

      match /roles/{roleId} {
        allow read: if isActiveMember(organizationId);

        // Os 7 system roles fixos só nascem dentro da transação server-side
        // de `createOrganization` (Admin SDK, TASK-037) — nunca pelo
        // cliente, nem mesmo pelo criador da Organization. O único `create`
        // que o cliente pode fazer aqui é um role custom, por quem já tem a
        // capability (roles de sistema nunca nascem por este caminho).
        allow create: if request.resource.data.organizationId == organizationId
          && hasCapability(organizationId, 'role.manage')
          && request.resource.data.isSystemRole == false;

        // Roles de sistema (isSystemRole == true) nunca podem ser
        // renomeados/alterados nem excluídos por regra — espelha
        // `assertRoleIsMutable` (TASK-028).
        allow update: if resource.data.isSystemRole == false
          && hasCapability(organizationId, 'role.manage')
          && unchanged('organizationId')
          && unchanged('isSystemRole');

        allow delete: if resource.data.isSystemRole == false
          && hasCapability(organizationId, 'role.manage');
      }

      // -------------------------------------------------------------------
      // organizations/{organizationId}/teams/{teamId}
      // -------------------------------------------------------------------

      match /teams/{teamId} {
        allow read: if isActiveMember(organizationId);

        allow create: if hasCapability(organizationId, 'team.manage')
          && request.resource.data.organizationId == organizationId;

        allow update: if hasCapability(organizationId, 'team.manage')
          && unchanged('organizationId');

        allow delete: if hasCapability(organizationId, 'team.manage');
      }

      // -------------------------------------------------------------------
      // organizations/{organizationId}/portfolioAssignments/{assignmentId}
      // (TASK-045)
      // -------------------------------------------------------------------

      match /portfolioAssignments/{assignmentId} {
        allow read: if hasCapability(organizationId, 'team.manage')
          || (
            isSalesRep(organizationId)
            && resource.data.userId == request.auth.uid
          );

        allow create: if hasCapability(organizationId, 'team.manage')
          && portfolioAssignmentPayloadValid(organizationId, request.resource.data)
          && request.resource.data.status == 'active'
          && request.resource.data.deletedAt == null;

        // Reassignment preserves history: clients may close an active
        // assignment, never rewrite its tenant/seller/team/scope identity.
        allow update: if hasCapability(organizationId, 'team.manage')
          && portfolioAssignmentPayloadValid(organizationId, request.resource.data)
          && unchanged('organizationId')
          && unchanged('companyId')
          && unchanged('userId')
          && unchanged('teamId')
          && unchanged('scopeType')
          && unchanged('customerId')
          && unchanged('region')
          && unchanged('segment')
          && unchanged('createdAt')
          && unchanged('createdBy')
          && request.resource.data.status in ['reassigned', 'archived'];

        allow delete: if false;
      }

      // -------------------------------------------------------------------
      // organizations/{organizationId}/customers/{customerId}
      // (TASK-045 visibility contract for TASK-048/TASK-051)
      // -------------------------------------------------------------------

      match /customers/{customerId} {
        allow get: if canReadCustomer(organizationId);
        allow list: if canListCustomers(organizationId);

        // Customer creation/editing belongs to TASK-048/TASK-049/TASK-051.
        allow create, update, delete: if false;
      }

      // -------------------------------------------------------------------
      // organizations/{organizationId}/customerImportTemplates/{templateId}
      // (TASK-167) — reusable column-mapping templates. Low-risk config
      // data (no financial/authorization impact), so — unlike
      // `customerImportJobs` below — the client writes it directly, same
      // "creator or admin manages, any active member with the capability
      // may create" shape `savedReports` (TASK-145) already uses.
      // -------------------------------------------------------------------

      function canManageCustomerImportTemplate(organizationId) {
        return isActiveMember(organizationId)
          && (resource.data.createdBy == request.auth.uid || isOwnerOrAdmin(organizationId));
      }

      match /customerImportTemplates/{templateId} {
        allow read: if hasCapability(organizationId, 'customer.import');

        allow create: if hasCapability(organizationId, 'customer.import')
          && request.resource.data.organizationId == organizationId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid;

        allow update: if canManageCustomerImportTemplate(organizationId)
          && hasCapability(organizationId, 'customer.import')
          && unchanged('organizationId')
          && unchanged('createdAt')
          && unchanged('createdBy')
          && request.resource.data.updatedBy == request.auth.uid;

        allow delete: if canManageCustomerImportTemplate(organizationId)
          && hasCapability(organizationId, 'customer.import');
      }

      // -------------------------------------------------------------------
      // organizations/{organizationId}/customerImportJobs/{jobId}
      // (TASK-167) — async customer-import job state. Exclusively written
      // by `startCustomerImportJob`/`processCustomerImportJob`/
      // `resolveCustomerImportDuplicateRow` (Admin SDK, bypasses these
      // Rules), same "server owns every write" shape `invites`/
      // `catalogShares` already use — a client-forged job document (fake
      // `importedCount`, a `storagePath` pointing at another organization,
      // ...) must never be possible.
      // -------------------------------------------------------------------

      match /customerImportJobs/{jobId} {
        allow read: if hasCapability(organizationId, 'customer.import');

        allow create, update, delete: if false;
      }

      // -------------------------------------------------------------------
      // organizations/{organizationId}/orders/{orderId}
      // (TASK-102 visibility contract for the pedidos listing/tracking
      // screen — writes remain the exclusive concern of the `submitOrder`
      // Cloud Function, TASK-101, which uses the Admin SDK and so bypasses
      // these Rules entirely.)
      // -------------------------------------------------------------------

      match /orders/{orderId} {
        allow get, list: if canReadOrder(organizationId);

        allow create, update, delete: if false;
      }

      // -------------------------------------------------------------------
      // organizations/{organizationId}/products/{productId}
      // (TASK-069 global product search)
      // -------------------------------------------------------------------

      match /products/{productId} {
        allow get, list: if canReadProduct(organizationId);

        // Product mutations still go through the local pending-sync path and
        // future server-side sync/validation work. The client may search/read
        // active catalog data, never directly create/update/delete it here.
        allow create, update, delete: if false;
      }

      // -------------------------------------------------------------------
      // organizations/{organizationId}/favorites/{favoriteId}
      // (TASK-079 personal, per-user product favorites — best-effort mirror
      // of the local-first Drift favorite store, never shared between
      // users. `favoriteId` is always `{userId}_{productId}`.)
      // -------------------------------------------------------------------

      match /favorites/{favoriteId} {
        // "read" (not split get/list) so a list query is only ever allowed
        // when every document it could return already satisfies
        // `resource.data.userId == request.auth.uid` — same pattern
        // `portfolioAssignments` above already relies on; the client query
        // itself must filter by `userId` for a list to actually succeed.
        allow read: if isActiveMember(organizationId)
          && resource.data.userId == request.auth.uid;

        allow create: if isActiveMember(organizationId)
          && request.resource.data.organizationId == organizationId
          && request.resource.data.userId == request.auth.uid
          && favoriteId
            == request.resource.data.userId + '_' + request.resource.data.productId;

        allow update: if isActiveMember(organizationId)
          && resource.data.userId == request.auth.uid
          && unchanged('organizationId')
          && unchanged('userId')
          && unchanged('productId');

        allow delete: if isActiveMember(organizationId)
          && resource.data.userId == request.auth.uid;
      }

      // -------------------------------------------------------------------
      // organizations/{organizationId}/catalogShares/{shareId}  (TASK-081)
      // -------------------------------------------------------------------
      //
      // Exclusively written by the `createCatalogShareLink`/
      // `registerCatalogShareOpen`/`revokeCatalogShareLink` Cloud Functions
      // (Admin SDK, which ignores these Rules) — same rationale as
      // `invites`: a share token needs to be generated server-side (never
      // guessable/reproducible from the client) and only its SHA-256 hash
      // (`tokenHash`) is ever persisted here, so `create`/`update`/`delete`
      // are all `if false` unconditionally.
      //
      // Reading a share directly from Firestore is restricted to its
      // creator (to see "foi aberto em...") or an OWNER/ADMIN auditing the
      // organization's shares (`catalog.manage`) — never to an anonymous or
      // unrelated caller, and never by presenting the plaintext token as a
      // document id/field: the public/anonymous recipient of a share link
      // never talks to Firestore directly at all, only to the
      // `getCatalogShareLink`/`registerCatalogShareOpen` Functions above,
      // which look the document up server-side by `tokenHash`. That is what
      // guarantees "nenhuma outra coleção fica acessível via o mesmo token"
      // (TASK-081): the token is never even presented to Firestore Rules in
      // the first place, by anyone, authenticated or not.

      match /catalogShares/{shareId} {
        allow read: if hasCapability(organizationId, 'catalog.manage')
          || (isActiveMember(organizationId) && resource.data.createdBy == request.auth.uid);

        allow create, update, delete: if false;
      }

      // -------------------------------------------------------------------
      // organizations/{organizationId}/productVariants/{variantId}
      // (TASK-072 generated sellable color/size variants)
      // -------------------------------------------------------------------

      match /productVariants/{variantId} {
        allow get, list: if canReadProductVariant(organizationId);
        allow create: if canCreateProductVariant(organizationId);
        allow update: if canUpdateProductVariant(organizationId);
        allow delete: if false;
      }

      // -------------------------------------------------------------------
      // organizations/{organizationId}/productImportTemplates/{templateId}
      // (TASK-168) — reusable column-mapping templates for the product
      // import wizard. Same low-risk, client-writable config shape as
      // `customerImportTemplates` above.
      // -------------------------------------------------------------------

      function canManageProductImportTemplate(organizationId) {
        return isActiveMember(organizationId)
          && (resource.data.createdBy == request.auth.uid || isOwnerOrAdmin(organizationId));
      }

      match /productImportTemplates/{templateId} {
        allow read: if hasCapability(organizationId, 'product.import');

        allow create: if hasCapability(organizationId, 'product.import')
          && request.resource.data.organizationId == organizationId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid;

        allow update: if canManageProductImportTemplate(organizationId)
          && hasCapability(organizationId, 'product.import')
          && unchanged('organizationId')
          && unchanged('createdAt')
          && unchanged('createdBy')
          && request.resource.data.updatedBy == request.auth.uid;

        allow delete: if canManageProductImportTemplate(organizationId)
          && hasCapability(organizationId, 'product.import');
      }

      // -------------------------------------------------------------------
      // organizations/{organizationId}/productImportJobs/{jobId}  (TASK-168)
      // — async product-import job state. Exclusively written by
      // `startProductImportJob`/`processProductImportJob` (Admin SDK, bypasses
      // these Rules), same "server owns every write" shape
      // `customerImportJobs` above already uses.
      // -------------------------------------------------------------------

      match /productImportJobs/{jobId} {
        allow read: if hasCapability(organizationId, 'product.import');

        allow create, update, delete: if false;
      }

      // -------------------------------------------------------------------
      // organizations/{organizationId}/erpIntegration/{config|credentials}
      // organizations/{organizationId}/erpSyncQueue/{itemId}
      // organizations/{organizationId}/erpSyncLogs/{logId}
      // organizations/{organizationId}/erpConflicts/{conflictId}
      // organizations/{organizationId}/erpSyncedRecords/{recordId}
      // organizations/{organizationId}/erpProcessedEvents/{idempotencyKey}
      // (TASK-169, EPIC-22 — framework de integração com ERPs)
      // -------------------------------------------------------------------
      //
      // Every document below is exclusively written by this feature's own
      // Cloud Functions (Admin SDK, bypasses these Rules) —
      // `saveErpIntegrationConfig`/`saveErpIntegrationCredentials`/
      // `processErpSyncQueueItem`/`pullErpInventoryAndPrices`/
      // `retryFailedErpSyncItems` — same "server owns every write" shape
      // `productImportJobs` above already uses, plus one deliberately
      // stricter rule: `erpIntegration/credentials` is never client-
      // readable at all, by any role, under any capability — a leaked
      // Firestore read of that single document would leak a live ERP
      // secret, so there is no capability check that could ever grant it
      // (TASK-169: "Nenhuma credencial de ERP de cliente é armazenada...
      // usar armazenamento seguro por tenant").

      match /erpIntegration/{documentId} {
        allow read: if documentId == 'config'
          && hasCapability(organizationId, 'erpIntegration.manage');
        // documentId == 'credentials' (or anything else) always denies read
        // — intentionally not `documentId == 'config' || ...`, so a typo'd
        // future document id under this same subcollection defaults to
        // denied, never accidentally readable.

        allow create, update, delete: if false;
      }

      match /erpSyncQueue/{itemId} {
        allow read: if hasCapability(organizationId, 'erpIntegration.manage');
        allow create, update, delete: if false;
      }

      match /erpSyncLogs/{logId} {
        allow read: if hasCapability(organizationId, 'erpIntegration.manage');
        allow create, update, delete: if false;
      }

      match /erpConflicts/{conflictId} {
        allow read: if hasCapability(organizationId, 'erpIntegration.manage');
        allow create, update, delete: if false;
      }

      match /erpSyncedRecords/{recordId} {
        allow read: if hasCapability(organizationId, 'erpIntegration.manage');
        allow create, update, delete: if false;
      }

      match /erpProcessedEvents/{idempotencyKey} {
        // Pure internal idempotency ledger — never read by any client, not
        // even by an OWNER/ADMIN with `erpIntegration.manage`; it carries no
        // information a human ever needs to see (`erpSyncLogs` already
        // reports every outcome, including "skipped, already processed").
        allow read, write: if false;
      }

      // -------------------------------------------------------------------
      // organizations/{organizationId}/webhooks/{webhookId}
      // organizations/{organizationId}/webhookSecrets/{webhookId}
      // organizations/{organizationId}/webhookDeliveries/{deliveryId}
      // organizations/{organizationId}/webhookDeliveryLogs/{logId}
      // (TASK-170, EPIC-22 — webhooks de saída)
      // -------------------------------------------------------------------
      //
      // Every document below is exclusively written by this feature's own
      // Cloud Functions (Admin SDK, bypasses these Rules) —
      // `saveWebhookConfig`/`regenerateWebhookSecret`/`sendTestWebhookEvent`/
      // `deliverWebhookEvent`/`retryFailedWebhookDeliveries` — same "server
      // owns every write" shape `erpIntegration`/`erpSyncQueue` above already
      // use, plus the same deliberately stricter rule: `webhookSecrets` is
      // never client-readable at all, by any role, under any capability — a
      // leaked Firestore read of that document would leak a live HMAC
      // secret an attacker could use to forge signed payloads toward the
      // organization's own webhook consumer (TASK-170: "Segredo HMAC nunca é
      // reexibido em texto claro após a criação inicial").

      match /webhooks/{webhookId} {
        allow read: if hasCapability(organizationId, 'webhook.manage');
        allow create, update, delete: if false;
      }

      match /webhookSecrets/{webhookId} {
        allow read, write: if false;
      }

      match /webhookDeliveries/{deliveryId} {
        allow read: if hasCapability(organizationId, 'webhook.manage');
        allow create, update, delete: if false;
      }

      match /webhookDeliveryLogs/{logId} {
        allow read: if hasCapability(organizationId, 'webhook.manage');
        allow create, update, delete: if false;
      }

      // -------------------------------------------------------------------
      // organizations/{organizationId}/priceLists/{priceListId}  (TASK-083)
      // -------------------------------------------------------------------
      //
      // Read escopado por organização: qualquer membro ativo pode ler as
      // tabelas de preço da própria organização (um representante precisa
      // delas para precificar um pedido), nunca de outra organização.
      // Escrita restrita a quem tem `priceList.manage` — hoje, apenas
      // OWNER/ADMIN/FINANCE (RolePermissionMatrix) — nunca SALES_REP/
      // SALES_MANAGER. Nenhum documento de Price List é fisicamente
      // excluído (soft delete via `deletedAt`, mesmo padrão de
      // `products`/`customers`).

      match /priceLists/{priceListId} {
        allow get, list: if canReadPriceList(organizationId);
        allow create: if canCreatePriceList(organizationId);
        allow update: if canUpdatePriceList(organizationId);
        allow delete: if false;
      }

      // -------------------------------------------------------------------
      // organizations/{organizationId}/warehouses/{warehouseId}  (TASK-089)
      // -------------------------------------------------------------------

      match /warehouses/{warehouseId} {
        allow get, list: if canReadWarehouse(organizationId);
        allow create: if canWriteWarehouse(organizationId);
        allow update: if canWriteWarehouse(organizationId)
          && unchanged('organizationId')
          && unchanged('companyId')
          && unchanged('createdAt')
          && unchanged('createdBy');
        allow delete: if false;
      }

      // -------------------------------------------------------------------
      // organizations/{organizationId}/inventory/{inventoryId}  (TASK-090)
      // -------------------------------------------------------------------

      match /inventory/{inventoryId} {
        allow get, list: if canReadInventoryBalance(organizationId);
        allow create, update, delete: if false;
      }

      match /stockAlerts/{alertId} {
        allow get, list: if hasCapability(organizationId, 'report.viewSensitive')
          || hasCapability(organizationId, 'inventory.adjust');
        allow create, update, delete: if false;
      }

      match /stockAlertRules/{ruleId} {
        allow get, list: if hasCapability(organizationId, 'inventory.adjust')
          || hasCapability(organizationId, 'report.viewSensitive');
        allow create: if hasCapability(organizationId, 'inventory.adjust')
          && request.resource.data.organizationId == organizationId
          && request.resource.data.minQuantity is int
          && request.resource.data.minQuantity >= 0
          && request.resource.data.alertLevel in ['low', 'critical']
          && request.resource.data.isActive is bool;
        allow update: if hasCapability(organizationId, 'inventory.adjust')
          && unchanged('organizationId')
          && unchanged('createdAt')
          && unchanged('createdBy');
        allow delete: if false;
      }

      match /stockAlertEvents/{eventId} {
        allow read, write: if false;
      }

      match /stockTurnoverDailyFacts/{factId} {
        allow read, write: if false;
      }

      match /stockTurnoverMetrics/{metricId} {
        allow get, list: if hasCapability(organizationId, 'report.viewSensitive')
          || hasCapability(organizationId, 'inventory.adjust');
        allow create, update, delete: if false;
      }

      match /stockReservations/{reservationId} {
        allow get, list: if canReadStockReservation(organizationId);
        allow create, update, delete: if false;
      }

      // -------------------------------------------------------------------
      // organizations/{organizationId}/{salesDaily,customerMonthly,
      // productMonthly,sellerMonthly,regionMonthly}Aggregates/{docId}
      // (TASK-133 — camada de agregação server-side)
      //
      // Pre-computed BI/dashboard snapshots (revenue/order-count/quantity by
      // day, customer, product/category/collection, seller and region) —
      // only ever written by the Admin SDK (`recomputeSalesDailyOnOrderWrite`
      // trigger / `recomputeMonthlyAggregates` callable / its nightly
      // schedule), never by the client, same `allow create, update, delete:
      // if false` already used by `stockTurnoverMetrics` above. Gated by
      // `report.viewSensitive` — same capability `stockTurnoverMetrics`
      // itself reads with, since these snapshots carry aggregated revenue,
      // the same class of sensitive commercial data.
      // -------------------------------------------------------------------

      match /salesDailyAggregates/{aggregateId} {
        allow get, list: if hasCapability(organizationId, 'report.viewSensitive');
        allow create, update, delete: if false;
      }

      match /customerMonthlyAggregates/{aggregateId} {
        allow get, list: if hasCapability(organizationId, 'report.viewSensitive');
        allow create, update, delete: if false;
      }

      match /productMonthlyAggregates/{aggregateId} {
        allow get, list: if hasCapability(organizationId, 'report.viewSensitive');
        allow create, update, delete: if false;
      }

      match /sellerMonthlyAggregates/{aggregateId} {
        allow get, list: if hasCapability(organizationId, 'report.viewSensitive');
        allow create, update, delete: if false;
      }

      match /sellerDailyAggregates/{aggregateId} {
        allow get, list: if canReadSellerAggregate(organizationId);
        allow create, update, delete: if false;
      }

      match /representativeMonthlyAggregates/{aggregateId} {
        allow get, list: if canReadSellerAggregate(organizationId);
        allow create, update, delete: if false;
      }

      match /regionMonthlyAggregates/{aggregateId} {
        allow get, list: if hasCapability(organizationId, 'report.viewSensitive');
        allow create, update, delete: if false;
      }

      // -------------------------------------------------------------------
      // organizations/{organizationId}/members/{userId}  (Membership)
      // -------------------------------------------------------------------

      match /members/{userId} {
        // Leitura de um único Membership (self-check de permissão,
        // resolução de role antes de uma troca de role/atribuição de
        // convite, etc.) permanece aberta a qualquer membro ativo — nunca
        // dependeu de capability alguma.
        allow get: if isActiveMember(organizationId);

        // `list` (a query administrativa por trás de `UserListPage`,
        // TASK-042) é mais sensível que um `get` isolado: enumerar todo o
        // roster da organização (nomes, e-mails, roles) só é permitido a
        // quem já tem `user.changeRole` — hoje, apenas OWNER/ADMIN
        // (RolePermissionMatrix). Nenhum caso de uso hoje chama
        // `MembershipRepository.listByOrganization` fora desse fluxo
        // administrativo, então esta restrição não quebra nenhum caminho
        // existente (self-check usa sempre `get`, nunca `list`).
        //
        // The second clause is what makes `MembershipRepository.listActiveByUser`
        // possible: a `collectionGroup('members')` query, spanning every
        // Organization at once, filtered by the caller's own `userId` (post-
        // login redirect/`ActiveOrganizationGuard` self-heal — see that
        // repository method's own docs for why it is the one exception to
        // every other method here requiring `organizationId`). Firestore
        // only allows a collection-group `list` when this holds for every
        // document it could return, so the client query itself must filter
        // by `userId`, same precedent as `favorites`/`portfolioAssignments`
        // above — nobody can ever enumerate another user's Memberships this
        // way.
        allow list: if hasCapability(organizationId, 'user.changeRole')
          || resource.data.userId == request.auth.uid;

        // A primeira Membership (OWNER) só nasce dentro da transação
        // server-side de `createOrganization` (Admin SDK, TASK-037) — nunca
        // pelo cliente, nem mesmo pelo próprio criador da Organization. O
        // único `create` que o cliente pode fazer aqui é um convite feito
        // por quem já tem a capability.
        allow create: if request.resource.data.organizationId == organizationId
          && request.resource.data.userId == userId
          && hasCapability(organizationId, 'user.invite');

        allow update: if request.resource.data.organizationId == organizationId
          && request.resource.data.userId == userId
          && unchanged('organizationId')
          && unchanged('userId')
          && (
            hasCapability(organizationId, 'user.changeRole')
            || hasCapability(organizationId, 'user.deactivate')
          );

        // Nenhum caso de uso exclui Membership hoje (desativar = status
        // 'inactive' via update) — nega por padrão.
        allow delete: if false;
      }

      // -------------------------------------------------------------------
      // organizations/{organizationId}/pushDevices/{deviceId}  (TASK-150)
      // -------------------------------------------------------------------
      //
      // Cada documento é o vínculo token FCM ↔ usuário ↔ dispositivo de um
      // único membro ativo, escrito pelo próprio cliente logo após login/
      // renovação de token (`PushTokenService`) — nunca por outro usuário.
      // Quem efetivamente envia push (Cloud Function, fora do escopo desta
      // task) usa o Admin SDK e ignora estas Rules, então a única
      // preocupação aqui é impedir que um cliente crie, leia ou altere o
      // vínculo de outro usuário. Nenhum caso de uso lista/enumera
      // `pushDevices` do cliente — `allow list: if false` — nem exclui
      // fisicamente um vínculo — desativação é sempre `deletedAt` via
      // `update` (mesma convenção de soft delete de todo o restante deste
      // arquivo).

      match /pushDevices/{deviceId} {
        allow get: if isActiveMember(organizationId)
          && resource.data.userId == request.auth.uid;

        allow list: if false;

        allow create: if isActiveMember(organizationId)
          && request.resource.data.organizationId == organizationId
          && request.resource.data.userId == request.auth.uid;

        allow update: if isActiveMember(organizationId)
          && request.resource.data.organizationId == organizationId
          && request.resource.data.userId == request.auth.uid
          && resource.data.userId == request.auth.uid
          && unchanged('organizationId')
          && unchanged('userId');

        allow delete: if false;
      }

      // -------------------------------------------------------------------
      // organizations/{organizationId}/notifications/{notificationId}  (TASK-151)
      // -------------------------------------------------------------------
      //
      // Central de notificações internas: cada documento pertence a um único
      // destinatário (`userId`) dentro da organização. `list`/`get` só
      // devolvem documentos cujo `userId` seja o do próprio requisitante —
      // como a query do cliente (`NotificationDataSource.listForUser`) já
      // filtra por `userId == auth.uid`, a regra é satisfeita para todo
      // documento realmente retornado e nega a operação inteira caso algum
      // dia uma query tente ler notificação de outro usuário. Hoje o próprio
      // app cria a notificação (ex.: alerta de meta, TASK-149) — por isso
      // `create` exige `userId == auth.uid` — mas o conteúdo (`title`,
      // `body`, `category`, `deepLink`, `createdAt`, `priority` — a
      // priorização visual crítico/informativo do TASK-153) nunca pode ser
      // alterado depois: `update` só aceita a marcação de leitura (`readAt`),
      // nunca reescrever o restante do documento.

      match /notifications/{notificationId} {
        allow get: if isActiveMember(organizationId)
          && resource.data.userId == request.auth.uid;

        allow list: if isActiveMember(organizationId)
          && resource.data.userId == request.auth.uid;

        allow create: if isActiveMember(organizationId)
          && request.resource.data.organizationId == organizationId
          && request.resource.data.userId == request.auth.uid;

        allow update: if isActiveMember(organizationId)
          && resource.data.userId == request.auth.uid
          && unchanged('organizationId')
          && unchanged('userId')
          && unchanged('category')
          && unchanged('title')
          && unchanged('body')
          && unchanged('deepLink')
          && unchanged('createdAt')
          && unchanged('priority');

        allow delete: if false;
      }

      // -------------------------------------------------------------------
      // organizations/{organizationId}/communicationPreferences/{userId}
      // (TASK-154)
      // -------------------------------------------------------------------
      //
      // One document per user, keyed by the user's own `uid` (never a
      // generated id) — the same convention `pushDevices` uses for the
      // Firestore Rules to validate ownership straight from the path,
      // without an extra read. `ShouldDispatchNotificationUseCase` (every
      // notification generator's gate, TASK-152/TASK-153) reads this
      // document server-side-equivalent from the client through the same
      // Rules below; nothing here ever exposes another user's preference
      // (`list` stays `if false` — a client only ever reads its own known
      // document id, never enumerates the collection).

      match /communicationPreferences/{userId} {
        allow get: if isActiveMember(organizationId) && userId == request.auth.uid;

        allow list: if false;

        allow create: if isActiveMember(organizationId)
          && userId == request.auth.uid
          && request.resource.data.organizationId == organizationId
          && request.resource.data.userId == request.auth.uid;

        allow update: if isActiveMember(organizationId)
          && userId == request.auth.uid
          && request.resource.data.organizationId == organizationId
          && request.resource.data.userId == request.auth.uid
          && unchanged('organizationId')
          && unchanged('userId');

        allow delete: if false;
      }

      // -------------------------------------------------------------------
      // organizations/{organizationId}/invites/{inviteId}  (TASK-039)
      // -------------------------------------------------------------------
      //
      // Exclusively written by the `createInvite`/`resendInvite`/
      // `revokeInvite` Cloud Functions (Admin SDK, which ignores these
      // Rules) — same rationale as `organizationOwners`/`organizations`
      // after TASK-037: a token needs to be generated server-side (never
      // guessable/reproducible from the client) and only its SHA-256 hash
      // (`tokenHash`) is ever persisted here, so `create`/`update`/`delete`
      // are all `if false` unconditionally. Reading the pending-invite list
      // (`InviteListPage`) is the one client operation allowed, gated by the
      // same `user.invite` capability required to create one in the first
      // place — exposing `tokenHash` to an OWNER/ADMIN who already has that
      // capability is not a secrecy concern (it is a one-way hash, not the
      // token itself).

      match /invites/{inviteId} {
        allow read: if hasCapability(organizationId, 'user.invite');

        allow create, update, delete: if false;
      }

      // -------------------------------------------------------------------
      // organizations/{organizationId}/auditLogs/{logId}  (TASK-033)
      // -------------------------------------------------------------------

      match /auditLogs/{logId} {
        // Leitura restrita à capability audit.log.view (hoje, apenas
        // OWNER/ADMIN — ver Capability.auditLogView/RolePermissionMatrix).
        allow read: if hasCapability(organizationId, 'audit.log.view');

        // Append-only: qualquer membro ativo pode registrar uma entrada
        // sobre uma ação que ele mesmo executou (actorUserId ==
        // request.auth.uid) — hoje isso é feito client-side, logo depois
        // da ação sensível em si (ex.: AssignRoleToUserUseCase), enquanto
        // não existe uma Cloud Function/trigger dedicada (ver
        // RecordAuditLogUseCase/AuditLogEntryFactory docs para o plano de
        // migração). Ninguém, nem OWNER, pode alterar ou excluir uma
        // entrada já criada.
        allow create: if isActiveMember(organizationId)
          && request.resource.data.organizationId == organizationId
          && request.resource.data.actorUserId == request.auth.uid;

        allow update: if false;
        allow delete: if false;
      }

      // -------------------------------------------------------------------
      // organizations/{organizationId}/savedReports/{reportId}  (TASK-145)
      // -------------------------------------------------------------------
      //
      // A `SavedReport` only ever persists the TASK-144 `ReportDefinition`
      // plus sharing metadata — never a cached query result (`executeReportQuery`,
      // TASK-144/TASK-133, always re-runs server-side, scoped to whoever is
      // executing, never to `ownerId`). `visibility` gates who can even see
      // the document: `private` (only its owner), `team` (the owner's own
      // team(s), re-derived here from the owner's *current* real Membership,
      // never a client-supplied list) or `organization` (every active
      // member). Raising `visibility` above `private` requires the caller —
      // not necessarily the owner, since an OWNER/ADMIN may also edit a
      // shared item — to hold the matching `report.share.team`/
      // `report.share.organization` capability (TASK-145,
      // RolePermissionMatrix); a `SALES_REP` who only has the former caps out
      // at `team`, exactly like the Dart matrix.

      function savedReportShareCapabilityAllowed(organizationId, visibility) {
        return visibility == 'organization'
          ? hasCapability(organizationId, 'report.share.organization')
          : visibility == 'team'
            ? hasCapability(organizationId, 'report.share.team')
            : visibility == 'private';
      }

      function canReadSavedReport(organizationId) {
        return isActiveMember(organizationId)
          && (
            resource.data.ownerId == request.auth.uid
            || resource.data.visibility == 'organization'
            || (
              resource.data.visibility == 'team'
              && exists(memberPath(organizationId, resource.data.ownerId))
              && get(memberPath(organizationId, resource.data.ownerId)).data.status == 'active'
              && requesterTeamIds(organizationId).hasAny(
                   get(memberPath(organizationId, resource.data.ownerId)).data.teamIds
                 )
            )
          );
      }

      // Apenas o dono ou OWNER/ADMIN podem editar/excluir uma visualização
      // salva — qualquer outro membro com acesso de leitura (via
      // `canReadSavedReport`) só a executa/visualiza, nunca a altera.
      function canManageSavedReport(organizationId) {
        return isActiveMember(organizationId)
          && (resource.data.ownerId == request.auth.uid || isOwnerOrAdmin(organizationId));
      }

      match /savedReports/{reportId} {
        allow read: if canReadSavedReport(organizationId);

        allow create: if isActiveMember(organizationId)
          && request.resource.data.organizationId == organizationId
          && request.resource.data.companyId is string
          && request.resource.data.companyId.size() > 0
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.visibility in ['private', 'team', 'organization']
          && savedReportShareCapabilityAllowed(organizationId, request.resource.data.visibility)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid;

        allow update: if canManageSavedReport(organizationId)
          && unchanged('organizationId')
          && unchanged('companyId')
          && unchanged('ownerId')
          && unchanged('createdAt')
          && unchanged('createdBy')
          && request.resource.data.visibility in ['private', 'team', 'organization']
          && savedReportShareCapabilityAllowed(organizationId, request.resource.data.visibility)
          && request.resource.data.updatedBy == request.auth.uid;

        allow delete: if canManageSavedReport(organizationId);
      }

      // -------------------------------------------------------------------
      // organizations/{organizationId}/reportSchedules/{scheduleId}
      // (TASK-149)
      // -------------------------------------------------------------------
      //
      // Periodic, automated delivery of a `SavedReport` (TASK-145). Only a
      // holder of `report.schedule` (OWNER/ADMIN/SALES_MANAGER,
      // RolePermissionMatrix) may create one, and only its own
      // `createdBy` or an OWNER/ADMIN may update (pause) or delete it —
      // same "creator or admin" precedent `canManageSavedReport` already
      // uses above. `nextRunAt`/`lastRun*` fields are only ever advanced by
      // the `runReportSchedules` Cloud Function (Admin SDK, bypasses these
      // Rules) — a client `update` may only ever touch `status` (pause) plus
      // its own audit fields, never the scheduling/execution bookkeeping the
      // Function alone owns.

      function canManageReportSchedule(organizationId) {
        return isActiveMember(organizationId)
          && (resource.data.createdBy == request.auth.uid || isOwnerOrAdmin(organizationId));
      }

      match /reportSchedules/{scheduleId} {
        allow read: if hasCapability(organizationId, 'report.schedule');

        allow create: if isActiveMember(organizationId)
          && hasCapability(organizationId, 'report.schedule')
          && request.resource.data.organizationId == organizationId
          && request.resource.data.companyId is string
          && request.resource.data.companyId.size() > 0
          && request.resource.data.savedReportId is string
          && request.resource.data.savedReportId.size() > 0
          && request.resource.data.status == 'active'
          && request.resource.data.recipientUserIds is list
          && request.resource.data.recipientUserIds.size() > 0
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid;

        // A client-side `update` (pause) may only ever flip `status` —
        // `nextRunAt`/`lastRunAt`/`lastRunCycleKey`/`lastRunStatus`/
        // `lastRunError` are exclusively written by `runReportSchedules`
        // (Admin SDK), so `unchanged('nextRunAt')` guards against a client
        // ever forging a fresh execution window for itself.
        allow update: if canManageReportSchedule(organizationId)
          && unchanged('organizationId')
          && unchanged('companyId')
          && unchanged('savedReportId')
          && unchanged('createdAt')
          && unchanged('createdBy')
          && unchanged('nextRunAt')
          && unchanged('lastRunAt')
          && unchanged('lastRunCycleKey')
          && unchanged('lastRunStatus')
          && request.resource.data.status in ['active', 'paused']
          && request.resource.data.updatedBy == request.auth.uid;

        allow delete: if canManageReportSchedule(organizationId);
      }

      // -------------------------------------------------------------------
      // organizations/{organizationId}/reportScheduleDeliveries/{deliveryId}
      // (TASK-149)
      // -------------------------------------------------------------------
      //
      // Append-only outcome log `runReportSchedules` writes once per
      // recipient per cycle (Admin SDK — `allow write: if false` below is
      // pure defense-in-depth). This is also the "notificação interna" queue
      // TASK-151 (Central de Notificações, not built yet) is expected to
      // read from — until then, a recipient can already see their own
      // deliveries directly here, and whoever manages schedules
      // (`report.schedule`) can see every delivery to diagnose a failure,
      // satisfying TASK-149's "falha de execução nunca é silenciosa".

      match /reportScheduleDeliveries/{deliveryId} {
        allow read: if isActiveMember(organizationId)
          && (
            resource.data.recipientUserId == request.auth.uid
            || hasCapability(organizationId, 'report.schedule')
          );

        allow write: if false;
      }
    }
  }
}
